{
  "name": "effect-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "tsc --noEmit && turbo run check",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "ui": "turbo run dev --filter=@effect-open-protocol/ui",
    "demo": "bun run packages/cli/src/chaos.ts",
    "soak": "bun run packages/cli/scripts/soak.ts",
    "controller": "bun run packages/cli/src/controller.ts",
    "client": "bun run packages/cli/src/client.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@types/bun": "latest",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
